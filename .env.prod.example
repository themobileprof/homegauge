# Runtime environment for the server. Copy to .env.prod, fill in, never commit.
# deploy/deploy.sh uploads this file to $DEPLOY_PATH/.env on the server.

APP_ENV=production
APP_URL=https://themobileprof.com/mortgage

# Go API
API_ADDR=:8085
DATABASE_URL=postgres://samuel@/homegauge?host=/var/run/postgresql
REDIS_URL=redis://127.0.0.1:6379/1
SESSION_SECRET=CHANGE_ME_long_random_32+_chars
SESSION_TTL_HOURS=168
CORS_ORIGINS=https://themobileprof.com
MAILER_MODE=smtp
SMTP_FROM=noreply@themobileprof.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
DOCUMENT_STORAGE_PATH=/home/samuel/apps/mortgage-ai/data/docs
AUTOMATION_LEVEL=suggest_only
SALARY_VARIANCE_PCT=15
SALARY_PAYDAY_LAST_DAYS=7
DEFAULT_ITI_PCT=35

# Paystack — pre-disbursement Fund & settle
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_DVA_BANK=wema-bank

# Next.js standalone (consumed by start-web.sh)
PORT=3035
NEXT_PUBLIC_BASE_PATH=/mortgage
SERVER_BASE_PATH=/mortgage        # server-only; tells the browser its API prefix at runtime
API_PROXY_TARGET=http://127.0.0.1:8085

# AI keys (only needed if AI features are enabled)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-6
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
