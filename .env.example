APP_ENV=development
APP_URL=http://localhost:3000
API_ADDR=:8080
DATABASE_URL=postgres://samuel@/homegauge?host=/var/run/postgresql
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=dev-only-change-me-homegauge-session
SESSION_TTL_HOURS=168
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAILER_MODE=log
SMTP_FROM=noreply@homegauge.local

# AI — only for unstructured work (statement extraction, optional numeric explanation).
# Eligibility, affordability, readiness, advisor checklists are programmatic.
# documents → Gemini; numerics explain → DeepSeek; fallback if preferred missing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
# alias: GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# n8n notification/escalation webhook (optional)
N8N_WEBHOOK_URL=

# Object storage (configure before document upload phase)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=homegauge-docs
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_PATH_STYLE=true

# Defaults (also stored in platform_settings for admin override)
AUTOMATION_LEVEL=suggest_only
SALARY_VARIANCE_PCT=15
SALARY_PAYDAY_LAST_DAYS=7
DEFAULT_ITI_PCT=35

# Paystack — pre-disbursement Fund & settle (Dedicated Virtual Accounts)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# wema-bank or titan-paystack (see Paystack DVA providers)
PAYSTACK_DVA_BANK=wema-bank
# Webhook URL to set in Paystack dashboard:
#   https://your-host/api/v1/webhooks/paystack
#   (with basePath: https://themobileprof.com/mortgage/api/v1/webhooks/paystack)

# Leave empty in local so the browser uses same-origin /api (Next proxies to the Go API).
NEXT_PUBLIC_API_URL=
