# Copy to .env.deploy and fill in. Never commit .env.deploy.

# ── SSH target ───────────────────────────────────────────────────────────────
DEPLOY_USER=samuel
DEPLOY_HOST=themobileprof.com
DEPLOY_PORT=22
DEPLOY_SSH_KEY=~/.ssh/id_ed25519          # optional; omit to use ssh-agent

# ── Remote paths ─────────────────────────────────────────────────────────────
DEPLOY_PATH=/home/samuel/apps/mortgage-ai  # directory on the server
DEPLOY_PM2_API_NAME=mortgage-api           # pm2 process name for Go API
DEPLOY_PM2_WEB_NAME=mortgage-web           # pm2 process name for Next.js

# ── What to run on the remote after rsync ────────────────────────────────────
DEPLOY_MIGRATE=true                        # run `migrate up` on the server
DEPLOY_SEED=false                          # re-seed lenders/products (safe, idempotent)

# ── Remote DB access (only needed when DEPLOY_SEED=true from your laptop) ────
# REMOTE_DATABASE_URL=postgres://samuel@127.0.0.1/homegauge
# DEPLOY_DB_TUNNEL=auto                    # auto|true|false — SSH -L when host is localhost
# DEPLOY_DB_TUNNEL_REMOTE=127.0.0.1:5432
